# ── Secrets ──
# JWT signing key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional dedicated salt for the privacy-preserving analytics visitor hash.
# If unset, a distinct key is derived from JWT_SECRET (HMAC), so this is only
# needed if you want to rotate the analytics salt independently of the JWT key.
# ANALYTICS_SALT=another-long-random-string

# ── Admin account (full access: /admin + /project) ──
# Passwords must be at least 12 characters and not on the denylist
# (the placeholders below are deliberately rejected — replace before booting).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Baptiste
ADMIN_PASSWORD=change-me-please

# ── Collaborator account (project workspace only) ──
MEMBER_EMAIL=collab@example.com
MEMBER_NAME=Collaborator
MEMBER_PASSWORD=change-me-too

# ── Server ──
PORT=3001
DB_PATH=/var/data/titisite/data.sqlite
UPLOADS_DIR=/var/data/titisite/uploads

# REQUIRED in production: prevents Host-header injection in generated iCal URLs.
# The server refuses to boot in NODE_ENV=production without it.
CANONICAL_ORIGIN=https://baptiste-niszczota.com

# Analytics country stats: name of the request header carrying the 2-letter
# country code. Leave EMPTY behind plain Nginx — a raw client header would let
# anyone poison the stats. Only set it when a trusted proxy overwrites it on
# every request (e.g. Cloudflare → "cf-ipcountry", or an Nginx GeoIP module).
# GEO_COUNTRY_HEADER=cf-ipcountry

# ── Email digest (optional) ──
# Without SMTP_HOST, the digest scheduler is a no-op (warning logged at boot).
# Users can still toggle their preference, but no emails will be sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=secret
# SMTP_SECURE=false             # true for port 465, false (STARTTLS) otherwise
# SMTP_FROM=Baptiste <no-reply@baptiste-niszczota.com>

# ── Quêtes : données de démonstration (optionnel) ──
# Au premier boot (table `factions` vide), un jeu de quêtes/factions d'exemple
# est inséré pour tester le module (supprimable depuis l'éditeur). Mettre `off`
# pour ne rien insérer.
# SEED_DEMO_QUESTS=off

# ── Minecraft : lecture d'un coffre depuis un screenshot (optionnel) ──
# Sans ANTHROPIC_API_KEY, l'onglet Minecraft retombe sur la saisie manuelle
# (le screenshot reste affiché en référence). Avec la clé, l'image est lue par
# l'API Claude. Attention : chaque scan est un appel facturé.
# ANTHROPIC_API_KEY=sk-ant-...
# MINECRAFT_VISION_MODEL=claude-sonnet-4-6  # défaut ; claude-opus-4-8 = plus cher, plus précis
# SCREENSHOT_MAX_BYTES=15728640             # taille max du screenshot uploadé (15 Mo)
